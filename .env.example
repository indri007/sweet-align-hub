# ==========================================
# 🔐 Sweet Align Hub - Environment Variables
# ==========================================
# Copy this file to '.env' and replace the placeholder values with your actual secrets.
# DO NOT commit your '.env' file to version control!

# ─── LLM Providers ────────────────────────────────────────
# You can use multiple Gemini API Keys separated by commas for rotation.
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# (Optional) OpenAI credentials
# OPENAI_API_KEY=sk-your-openai-key-here

# ─── Primary Vector Store (Jobs) ──────────────────────────
QDRANT_URL=https://your-primary-qdrant-cluster.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_primary_qdrant_api_key

# ─── Secondary Vector Store (AI Brain & Memory) ───────────
CS_QDRANT_URL=https://your-secondary-qdrant-cluster.aws.cloud.qdrant.io:6333
CS_QDRANT_API_KEY=your_secondary_qdrant_api_key

# ─── Data Streaming (Aiven Kafka) ─────────────────────────
KAFKA_URI=kafka-your-instance.aivencloud.com:19453
KAFKA_USER=avnadmin
KAFKA_PASS=your_aiven_password_here
KAFKA_CA_PATH=ca.pem

# ─── Webhooks & Third-Party (Optional) ────────────────────
# N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/123
# USE_N8N=false
